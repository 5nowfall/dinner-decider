{
  "manifest_version": 3,
  "name": "Dinner Decider: What's for Dinner Tonight?",
  "short_name": "Dinner Decider",
  "version": "1.0.0",
  "description": "Can't decide what to cook? Get tonight's dinner in one click, then cook along with step-by-step timers.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "What's for dinner?",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
